{
  "name": "cliproxy-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Frontend for CLIProxyAPI native management APIs",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "web"
  ],
  "scripts": {
