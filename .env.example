# Template only: export these in the server process environment.
# Environment > local SQLite > generic defaults. This file is not auto-loaded.
CLIPROXY_DISPLAY_NAME="CLIProxy Console"
CLIPROXY_URL=http://127.0.0.1:8317
# Supply your existing CLIProxyAPI keys here OR through Settings (SQLite).
CLIPROXY_MGMT_KEY=
CLIPROXY_API_KEY=
PORT=8320
# Optional overrides; omit to use defaults. Paths can start with ~/.
# CLIPROXY_DATA_DIR=~/.cliproxy-console
# CLIPROXY_SETTINGS_DB=~/.cliproxy-console/settings.sqlite
# CLIPROXY_CONSOLE_URL=http://127.0.0.1:8320
# CLIPROXY_DESKTOP_CONFIG_DIR="~/Library/Application Support/Claude-3p/configLibrary"
# CLAUDE_CONFIG_DIR=~/.claude
# CLIPROXY_AUTH_DIR=~/.cli-proxy-api
# CLIPROXY_CONFIG=/absolute/path/to/cliproxyapi.conf

# Optional overrides of frontend model settings. Do not use account-prefixed IDs.
# CLIPROXY_CLAUDE_MODELS='[{"id":"claude-opus-5","label":"Claude Opus 5","contextWindow":1000000,"maxEffort":"max"}]'
# CLIPROXY_CLI_EFFORT=high
# CLIPROXY_STARTUP_FILE=~/.cliproxy-console/startup.json

# Optional independent model-role defaults (must be in the allowed model list).
# CLIPROXY_CLAUDE_BACKGROUND_MODEL=claude-opus-5
# CLIPROXY_CLAUDE_SUBAGENT_MODEL=claude-opus-5
# CLIPROXY_CLI_PROFILE=your-saved-profile-id
